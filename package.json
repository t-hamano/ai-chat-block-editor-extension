{
	"name": "blocktune",
	"version": "0.1.0",
	"description": "Select blocks or text in the block editor and edit them by chatting with AI.",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"gutenberg",
		"block",
		"ai",
		"assistant"
	],
	"homepage": "https://github.com/t-hamano/blocktune",
	"repository": "git+https://github.com/t-hamano/blocktune.git",
	"bugs": {
		"url": "https://github.com/t-hamano/blocktune/issues"
	},
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.19.1"
	},
	"files": [
		"classes",
		"src",
		"!src/**/test",
		"skills",
		"build",
		"blocktune.php",
		"uninstall.php"
	],
	"dependencies": {
		"@wordpress/icons": "20.0.0",
		"@wordpress/ui": "0.26.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"uuid": "14.0.3"
	},
	"devDependencies": {
		"@types/react": "18.3.31",
		"@wordpress/a11y": "5.1.0",
		"@wordpress/api-fetch": "8.1.0",
		"@wordpress/block-editor": "20.0.0",
		"@wordpress/block-library": "12.1.0",
		"@wordpress/block-serialization-default-parser": "6.1.0",
		"@wordpress/blocks": "17.1.0",
		"@wordpress/data": "11.1.0",
		"@wordpress/editor": "16.1.0",
		"@wordpress/element": "10.1.0",
		"@wordpress/env": "^12.2.0",
		"@wordpress/hooks": "5.1.0",
		"@wordpress/i18n": "7.1.0",
		"@wordpress/keycodes": "5.1.0",
		"@wordpress/plugins": "8.1.0",
		"@wordpress/preferences": "5.1.0",
		"@wordpress/primitives": "5.1.0",
		"@wordpress/rich-text": "8.1.0",
		"@wordpress/scripts": "^37.2.0",
		"husky": "^9.1.7",
		"jsdom": "31.0.1",
		"lint-staged": "17.6.0",
		"prettier": "npm:wp-prettier@3.9.6",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"scripts": {
		"wp-env": "wp-env",
		"wp-env-test": "wp-env --config .wp-env.test.json",
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"plugin-zip": "npm run build && wp-scripts plugin-zip",
		"check-licenses": "wp-scripts check-licenses",
		"lint": "npm run lint:css && npm run lint:js && npm run lint:types && npm run lint:php && npm run lint:md-docs && npm run lint:pkg-json && npm run lint:block-reference",
		"lint:css": "wp-scripts lint-style --allow-empty-input",
		"lint:js": "wp-scripts lint-js",
		"lint:types": "tsc",
		"lint:php": "vendor/bin/phpcs",
		"lint:md-docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:block-reference": "npm run generate:block-reference -- --check",
		"format": "wp-scripts format",
		"generate:block-reference": "node scripts/generate-block-reference.cjs",
		"test:unit": "wp-scripts test-unit-js",
		"test:php": "wp-env --config .wp-env.test.json run cli --env-cwd=wp-content/plugins/blocktune vendor/bin/phpunit",
		"eval": "npx --yes promptfoo@0.125.1 eval -c scripts/eval/promptfooconfig.yaml",
		"eval:view": "npx --yes promptfoo@0.125.1 view",
		"eval:record": "node scripts/eval/record.mjs",
		"eval:chart": "node scripts/eval/chart.mjs",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,tsx,json,yml,yaml}": [
			"wp-scripts format"
		],
		"*.{js,ts,tsx}": [
			"wp-scripts lint-js"
		],
		"*.scss": [
			"wp-scripts lint-style"
		],
		"*.php": [
			"vendor/bin/phpcs"
		],
		"*.md": [
			"wp-scripts lint-md-docs"
		],
		"package.json": [
			"wp-scripts lint-pkg-json"
		]
	}
}
